---
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Loader from '../components/Loader.astro';
import Cursor from '../components/Cursor.astro';
import ogSource from '../assets/photos/fb_141_signature.jpg';
import {
  areaServed,
  defaultSiteUrl,
  facebookUrl,
  instagramUrl,
  noindexEnabled,
  siteName,
  skipLabel,
} from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, image, imageAlt = 'Tina Campbell Photography', jsonLd } = Astro.props;
const origin = Astro.site ?? new URL(defaultSiteUrl);
const canonical = new URL(Astro.url.pathname, origin);
const generated = await getImage({
  src: ogSource,
  width: 1200,
  height: 630,
  format: 'jpg',
  fit: 'cover',
});
const imageUrl = new URL(image ?? generated.src, origin).href;
const noindex = noindexEnabled();

const businessId = new URL('/#business', origin).href;
const personId = new URL('/#tina', origin).href;
const graph: Record<string, unknown>[] = [
  {
    '@type': ['ProfessionalService', 'LocalBusiness'],
    '@id': businessId,
    name: siteName,
    url: new URL('/', origin).href,
    image: imageUrl,
    description: 'Fashion, portrait and runway photographer in Edmonton, Alberta.',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Edmonton',
      addressRegion: 'AB',
      addressCountry: 'CA',
    },
    areaServed: [...areaServed],
    sameAs: [instagramUrl, facebookUrl],
    founder: { '@id': personId },
  },
  {
    '@type': 'Person',
    '@id': personId,
    name: 'Tina Campbell',
    jobTitle: 'Photographer',
    url: new URL('/', origin).href,
    worksFor: { '@id': businessId },
    sameAs: [instagramUrl, facebookUrl],
  },
];
if (jsonLd) graph.push(...(Array.isArray(jsonLd) ? jsonLd : [jsonLd]));
const json = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style is:inline>
      html { background: #0c0c0f; }
      .loader { display: none; }
      html.loader-play .loader { display: block; }
      html.loader-play .site-reveal { opacity: 0; }
    </style>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var reduce = false;
        try { reduce = matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
        var seen = false;
        try { seen = sessionStorage.getItem('tc-loader') === '1'; } catch (e) { seen = true; }
        if (reduce || seen) root.classList.add('loader-skip');
        else root.classList.add('loader-play');
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <meta name="theme-color" content="#0C0C0F" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script type="application/ld+json" set:html={json} />
    <slot name="head" />
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#content">{skipLabel}</a>
    <Header />
    <Loader />
    <div class="grain" aria-hidden="true"></div>
    <Cursor />
    <div class="site-reveal">
      <slot />
      <Footer />
    </div>
    <script>
      import { bindMotion } from '../scripts/motion/core';
      bindMotion();
    </script>
  </body>
</html>
