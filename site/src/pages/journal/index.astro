---
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/Photo.astro';
import { getPhoto } from '../../data/photos';
import { defaultSiteUrl } from '../../data/site';
import '../../styles/pages.css';

const title = 'Journal | Tina Campbell Photography, Edmonton';
const description =
  'Edmonton photography guides: locations, what to wear, bridal and portrait tips, and behind the scenes from Tina Campbell.';
const posts = (await getCollection('journal')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = posts[0];
if (!featured) throw new Error('Journal is empty');
const rest = posts.slice(1);
const hero = getPhoto(featured.data.hero);
const og = await getImage({ src: hero.src, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const origin = Astro.site ?? new URL(defaultSiteUrl);
const pageUrl = new URL('/journal/', origin).href;

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('en-CA', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  }).format(date);
}

const jsonLd = {
  '@type': 'Blog',
  name: 'Journal',
  description,
  url: pageUrl,
  blogPost: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    datePublished: post.data.date.toISOString(),
    url: new URL(`/journal/${post.id}/`, origin).href,
  })),
};
---

<BaseLayout title={title} description={description} image={og.src} imageAlt={hero.alt} jsonLd={jsonLd}>
  <link slot="head" rel="alternate" type="application/rss+xml" title="Journal" href="/rss.xml" />
  <main id="content" class="page">
    <div class="page-wrap">
      <h1 class="display">Journal</h1>
      <p class="lead">Guides and behind the scenes from shoots around Edmonton.</p>
      <a class="journal-feature" href={`/journal/${featured.id}/`}>
        <div class="letterbox">
          <div class="letterbox__bar letterbox__bar--top" data-letterbox-bar></div>
          <Photo src={hero.src} alt={hero.alt} sizes="(max-width: 900px) 92vw, 1100px" widths={[800, 1200, 1600]} priority />
          <div class="letterbox__bar letterbox__bar--bottom" data-letterbox-bar></div>
        </div>
        <p class="meta-line">{formatDate(featured.data.date)} · {featured.data.location}</p>
        <h2>{featured.data.title}</h2>
        <p>{featured.data.description}</p>
      </a>
      <ul class="journal-list">
        {
          rest.map((post) => {
            const photo = getPhoto(post.data.hero);
            return (
              <li>
                <a href={`/journal/${post.id}/`} data-journal-row>
                  <Photo src={photo.src} alt="" sizes="140px" widths={[480]} />
                  <div>
                    <p class="meta-line">{formatDate(post.data.date)}</p>
                    <h2>{post.data.title}</h2>
                    <p>{post.data.location}</p>
                  </div>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </main>
</BaseLayout>
