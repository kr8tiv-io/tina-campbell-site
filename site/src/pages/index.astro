---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeSheet from '../components/HomeSheet.astro';
import Photo from '../components/Photo.astro';
import { getPhoto } from '../data/photos';
import '../styles/home.css';
import '../styles/seams.css';

const hero = getPhoto('fb_013_signature');
const runway = [
  { photo: getPhoto('fb_085_runway'), n: '01', href: '/runway/', pos: 'pos-stage', location: 'Edmonton' },
  { photo: getPhoto('fb_029_runway'), n: '02', href: '/runway/', pos: 'pos-stage', location: 'Edmonton' },
  { photo: getPhoto('fb_037_runway'), n: '03', href: '/runway/', pos: 'pos-stage', location: 'Edmonton' },
  { photo: getPhoto('fb_158_runway'), n: '04', href: '/runway/', pos: 'pos-stage', location: 'Edmonton' },
  { photo: getPhoto('fb_105_runway'), n: '05', href: '/runway/', pos: 'pos-stage', location: 'Edmonton' },
];
const categories = [
  { label: 'Signature', filter: 'fashion', photo: getPhoto('fb_046_signature'), n: '01', pos: 'cat-signature' },
  { label: 'Runway', filter: 'runway', photo: getPhoto('fb_041_runway'), n: '02', pos: 'cat-runway' },
  { label: 'Portraits', filter: 'portraits', photo: getPhoto('fb_048_portrait'), n: '03', pos: 'cat-portrait' },
  { label: 'Bridal', filter: 'bridal', photo: getPhoto('fb_061_bridal'), n: '04', pos: 'cat-bridal' },
  { label: 'Couples', filter: 'couples', photo: getPhoto('fb_007_couples'), n: '05', pos: 'cat-couples' },
  { label: 'Edmonton', filter: 'edmonton', photo: getPhoto('fb_066_city'), n: '06', pos: 'cat-city' },
  { label: 'Landscape', filter: 'edmonton', photo: getPhoto('fb_000_landscape'), n: '07', pos: 'cat-landscape' },
];
/**
 * 02A ribbon past each end: at the first and last category the side frames are real photos, not empty film.
 * Each is used once on this page, watermark-free at the strip crop, and kept off the other home sections.
 */
const fillIds: Array<['lead' | 'tail', string]> = [
  ['lead', 'fb_123_fashion'],
  ['lead', 'fb_042_fashion'],
  ['lead', 'fb_137_portrait'],
  ['lead', 'fb_127_portrait'],
  ['tail', 'fb_001_city'],
  ['tail', 'fb_132_couples'],
  ['tail', 'fb_135_couples'],
  ['tail', 'fb_140_portrait'],
];
const fill = await Promise.all(
  fillIds.map(async ([side, id]) => ({
    side,
    src: (await getImage({ src: getPhoto(id).src, width: 480, format: 'webp' })).src,
  })),
);
const teaser = getPhoto('fb_016_signature');
const skyline = getPhoto('fb_577057434409234');

const title = 'Tina Campbell Photography | Fashion and Portrait Photographer in Edmonton';
const description =
  'Fashion, editorial, runway and portrait photography in Edmonton, Alberta by Tina Campbell. Bold, polished images shot around the city. Book a shoot.';
---

<BaseLayout title={title} description={description} imageAlt={hero.alt}>
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/media/scenes/01A/01A-poster.webp"
    type="image/webp"
    fetchpriority="high"
  />
  <script is:inline slot="head">
    if (document.documentElement.classList.contains('loader-skip')) {
      document.documentElement.classList.add('hero-poster-inset');
    }
  </script>
  <main id="content" data-page="home" data-keep-header>
    <div data-seam-pair="01A-02A">
      <div class="seam-real__track" data-track>
        <div class="seam-real__stage" data-stage>
          <section class="hero" data-hero data-seam-out data-out>
            <span class="seam-real__ghost" data-seam-title aria-hidden="true">Tina Campbell</span>
            <div class="hero__media" data-seam-media>
              <div class="hero__shift" data-hero-shift>
                <div class="hero__zoom" data-hero-zoom>
                  <picture class="hero__still">
                    <source
                      srcset="/media/scenes/01A/01A-end.webp"
                      type="image/webp"
                      media="(prefers-reduced-motion: reduce)"
                    />
                    <img
                      src="/media/scenes/01A/01A-poster.webp"
                      alt="Model in a red gown on a teal truck, one leg extended, clear blue sky."
                      width="1920"
                      height="1080"
                      fetchpriority="high"
                      loading="eager"
                      data-scene-still="01A"
                    />
                  </picture>
                  <video
                    data-scene-video="01A"
                    class="hero__video"
                    muted
                    playsinline
                    preload="none"
                    poster="/media/scenes/01A/01A-poster.webp"
                    aria-hidden="true"
                  ></video>
                  <div class="hero__night" data-scene-overlay aria-hidden="true"></div>
                  <div class="hero__warm" data-scene-overlay aria-hidden="true"></div>
                </div>
              </div>
              <div class="hero__shade" data-scene-overlay aria-hidden="true"></div>
              <div class="hero__grain" data-scene-overlay aria-hidden="true"></div>
            </div>
            <div class="hero__copy" data-hero-copy data-scene-copy>
              <h1 class="hero__title" data-hero-title><span class="hero__first">Tina</span> <span class="hero__last">Campbell</span></h1>
              <div class="hero__meta">
                <p class="hero__caption">No. 001 / Alberta Legislature, Edmonton</p>
                <span class="hero__rule" aria-hidden="true"></span>
                <p class="hero__scroll">Scroll</p>
              </div>
            </div>
          </section>
          <HomeSheet items={categories} place="in" fill={fill} />
        </div>
      </div>
    </div>
    <div data-seam-pair="02A-03B">
      <div class="seam-real__track" data-track>
        <div class="seam-real__stage" data-stage>
          <HomeSheet items={categories} place="out" />
          <section class="runway runway--stage" data-runway-pin data-seam-in data-in aria-labelledby="runway-label">
            <span class="seam-real__ghost" data-seam-title aria-hidden="true">Runway</span>
            <div class="runway__stage" data-seam-media>
              <picture class="runway__still">
                <source
                  srcset="/media/scenes/03B/03B-end.webp"
                  type="image/webp"
                  media="(prefers-reduced-motion: reduce)"
                />
                <img
                  src="/media/scenes/03B/03B-poster.webp"
                  alt="Five models on a dark runway as a followspot finds the red gown."
                  width="1920"
                  height="1080"
                  loading="lazy"
                  data-scene-still="03B"
                />
              </picture>
              <video
                data-scene-video="03B"
                data-scene-mode="scrub"
                class="runway__video"
                muted
                playsinline
                preload="none"
                poster="/media/scenes/03B/03B-poster.webp"
                aria-hidden="true"
              ></video>
              <div class="runway__shade" data-scene-overlay aria-hidden="true"></div>
            </div>
            <div class="runway__copy" data-scene-copy>
              <h2 class="runway__label" id="runway-label">The Runway</h2>
              <ol class="runway__marks">
                {
                  runway.map((item) => (
                    <li>
                      <span class="runway__mark-no">{item.n}</span>
                      <span class="runway__mark-loc">{item.location}</span>
                    </li>
                  ))
                }
              </ol>
            </div>
          </section>
        </div>
      </div>
    </div>

    <section class="runway runway--strip" data-runway-strip data-home-runway aria-label="Runway frames">
      <div class="runway__viewport" data-runway-viewport>
        <ol class="runway__track" data-runway-track>
          {
            runway.map((item) => (
              <li class="runway__item" data-no={item.n} data-location={item.location}>
                <figure class="runway__frame">
                  <a href={item.href} data-cursor="View">
                    <Photo
                      src={item.photo.src}
                      alt={item.photo.alt}
                      sizes="(max-width: 960px) 72vw, 22vw"
                      class={item.pos}
                      priority
                    />
                  </a>
                </figure>
                <p class="runway__num">{item.n}</p>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="runway__progress" data-runway-progress>
        <span data-runway-bar></span>
      </div>
      <div class="runway__caption" data-runway-caption>
        <p data-runway-no>No. 001</p>
        <p data-runway-loc>Edmonton</p>
      </div>
    </section>

    <section class="statement" aria-labelledby="statement-heading">
      <h2 id="statement-heading" data-statement>Edmonton is my runway.</h2>
      <p data-statement-sub>
        Fashion, portraits, bridal and runway, shot on location around the city.
      </p>
    </section>

    <section class="teaser" aria-labelledby="teaser-heading">
      <div class="teaser__copy">
        <p class="teaser__kicker">Featured series</p>
        <h3 id="teaser-heading">The Red Gown</h3>
        <p class="teaser__text">
          A crimson gown, a 1960s Fargo truck and a hard blue Alberta sky. One of the shoots that defines my work.
        </p>
        <a class="text-link" href="/series/the-red-gown/">View the series</a>
      </div>
      <div class="teaser__media" data-parallax-mask>
        <div class="teaser__shift" data-parallax-photo>
          <a href="/series/the-red-gown/" data-cursor="View">
            <Photo
              src={teaser.src}
              alt={teaser.alt}
              sizes="(max-width: 800px) 100vw, 56vw"
              class="pos-teaser"
            />
          </a>
        </div>
      </div>
    </section>

    <section class="band" data-band aria-labelledby="band-heading">
      <div class="band__bg" aria-hidden="true">
        <div class="band__sky" data-band-sky>
          <div class="band__layer">
            <Photo src={skyline.src} alt={skyline.alt} sizes="100vw" />
          </div>
        </div>
      </div>
      <div class="band__shade" aria-hidden="true"></div>
      <div class="band__inner">
        <div>
          <h2 id="band-heading">Let's make something bold.</h2>
          <p class="band__text">
            Portraits, fashion, bridal and events in Edmonton, St. Albert and Fort Saskatchewan.
          </p>
          <a class="btn" href="/book/">Book a shoot</a>
        </div>
      </div>
    </section>

    <a class="book-bar" href="/book/" data-book-bar>Book a shoot</a>
  </main>
</BaseLayout>
