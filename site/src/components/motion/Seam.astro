---
import type { ImageMetadata } from 'astro';
import '../../styles/seams.css';

interface Props {
  id: string;
}

const { id } = Astro.props;
const files = import.meta.glob<ImageMetadata>('../../../public/motion-lab/media/**/*.jpg', {
  eager: true,
  import: 'default',
});
const byPath = new Map<string, string>();
for (const [key, file] of Object.entries(files)) {
  const src = typeof file === 'string' ? file : file.src;
  byPath.set(key.replace(/^.*\/media\//, ''), src);
}

function media(path: string): string {
  const src = byPath.get(path);
  if (!src) throw new Error(`Missing seam media ${path}`);
  return src;
}

const editorialTitle = 'Fashion<br><em class="amp">&amp; Editorial</em>';
---

